extends SceneTree

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var scene := load("res://scenes/main/main.tscn") as PackedScene
	assert(scene != null)
	var instance := scene.instantiate()
	root.add_child(instance)
	await process_frame
	# Declare the empty inventory fixture explicitly; a fresh game seeds arena test items.
	instance.item_repository = ItemRepository.new()
	instance.player_character.inventory = InventoryState.new(instance.player_character.character_id)
	instance.player_character.equipment = EquipmentState.new()
	instance.call("_open_panel", "Персонаж")
	await process_frame
	var screen := instance.get_node_or_null("CharacterScreen") as CharacterScreen
	assert(screen != null and screen.visible)
	assert(screen.character != null)
	assert(screen.layout_row != null)
	assert(screen.square_host != null)
	assert(screen.details_panel != null)
	assert(screen.detail_tabs != null)
	assert(screen.detail_tabs.get_tab_count() == 4)
	var primary_config := PrimaryStatEffects.load_config()
	assert(primary_config.has("effects"))
	assert(primary_config.has("categories"))
	var test_bonuses := PrimaryStatEffects.calculate({"PAR001": 10, "PAR002": 20, "PAR003": 20, "PAR004": 10, "PAR005": 10, "PAR006": 10})
	assert(is_equal_approx(float(test_bonuses["physical_damage_flat"]), 10.0))
	assert(is_equal_approx(float(test_bonuses["dodge_rating"]), 100.0))
	assert(is_equal_approx(float(test_bonuses["crit_damage_rating"]), 100.0))
	assert(is_equal_approx(float(test_bonuses["max_hp_flat"]), 200.0))
	assert(is_equal_approx(float(test_bonuses["crit_chance_rating"]), 150.0))
	assert(is_equal_approx(float(test_bonuses["hit_chance_rating"]), 50.0))
	assert(is_equal_approx(float(test_bonuses["magic_damage_rating"]), 50.0))
	assert((screen.detail_values["PAR035"] as Label).text.contains("%)"))
	assert((screen.detail_values["PAR151"] as Label).text == "—")
	var unarmed_config: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/combat/unarmed_attack.json"))
	assert(unarmed_config is Dictionary)
	assert(int(unarmed_config["unarmed"]["min_damage"]) == 2)
	assert(int(unarmed_config["unarmed"]["max_damage"]) == 4)
	assert(screen.character.equipment.get_equipped_instance_id("main_hand") == null)
	var canonical := CharacterStatsService.snapshot(screen.character, instance.item_repository)
	assert(canonical.has("main_hand_damage"))
	var combat_totals := CharacterStatsService.combat_stats(screen.character, instance.item_repository)
	var built_fighter := CharacterCombatBuilder.build(screen.character, instance.item_repository)
	var built_profiles:Array = built_fighter.combat_stats.get("weapon_profiles", [])
	var combat_profiles:Array = combat_totals.get("weapon_profiles", [])
	assert(built_fighter.level == screen.character.progression.level)
	assert(is_equal_approx(float(built_fighter.combat_stats["crit_chance_rating_percent"]), float(canonical["crit_chance_rating_percent"])))
	assert(built_fighter.combat_stats["abilities"] == EquipmentAbilityLoadout.active_abilities(screen.character, instance.item_repository))
	assert(built_profiles.size() == 1)
	assert(combat_profiles.size() == 1)
	assert(is_equal_approx(float(built_profiles[0]["damage_min"]), float(combat_profiles[0]["damage_min"])))
	assert(is_equal_approx(float(built_profiles[0]["damage_max"]), float(combat_profiles[0]["damage_max"])))

	assert(is_equal_approx(float(combat_profiles[0]["damage_min"]), float(canonical["main_hand_min_damage"])))
	assert(is_equal_approx(float(combat_profiles[0]["damage_max"]), float(canonical["main_hand_max_damage"])))
	assert(not combat_totals.has("main_hand_damage"))
	assert(is_equal_approx(float(combat_totals["crit_chance_rating_percent"]), float(canonical["crit_chance_rating_percent"])))
	assert(is_equal_approx(float(canonical["crit_chance_rating_percent"]), PrimaryStatEffects.rating_to_percent(float(canonical["crit_chance_rating"]), screen.character.progression.level)))
	assert(is_equal_approx(CharacterStatsService.rating_effect(canonical, "crit_chance_rating"), float(canonical["crit_chance_rating_percent"])))
	var direct_effect := CharacterStatsService.snapshot(screen.character, instance.item_repository, {"crit_chance_rating": 5.0})
	assert(is_equal_approx(float(direct_effect["crit_chance_rating"]), float(canonical["crit_chance_rating"]) + 5.0))
	var fist_bonus := int(screen.character.progression.base_stats["PAR001"])
	assert((screen.detail_values["PAR050"] as Label).text.contains("2") or (screen.detail_values["PAR050"] as Label).text != "—")
	assert(not screen.detail_values.has("main_hand_min_damage"))
	assert(not screen.detail_values.has("main_hand_max_damage"))

	var offhand_test := {"instance_id":"ui_offhand_test","type":"weapon","equip_slots":["off_hand"],"slot_usage":["off_hand"],"damage":{"min":4,"max":6,"type":"piercing"},"par_stats":{"PAR057":1}}
	ItemDurabilityService.initialize_item(offhand_test, 100)
	assert(instance.item_repository.add_item(offhand_test))
	assert(screen.character.receive_item("ui_offhand_test", instance.item_repository))
	assert(screen.character.equip("off_hand", "ui_offhand_test", instance.item_repository))
	screen.refresh()
	assert(screen.detail_values["PAR051"].text != "—")
	screen.character.unequip("off_hand", instance.item_repository)
	screen.refresh()
	assert(screen.detail_values["PAR051"].text != "—")
	assert(screen.character.remove_item("ui_offhand_test"))
	instance.item_repository.remove_item("ui_offhand_test")

	# RatingMatrix v1: 100 rating = 10% at level 1, 1% at level 100.
	assert(is_equal_approx(PrimaryStatEffects.rating_to_percent(100.0, 1), 10.0))
	assert(is_equal_approx(PrimaryStatEffects.rating_to_percent(100.0, 100), 1.0))
	assert(is_equal_approx(PrimaryStatEffects.rating_to_percent(300.0, 30), 3.0 * (10.0 - 9.0 * 29.0 / 99.0)))
	assert(is_equal_approx(PrimaryStatEffects.effective_chance(300.0, 100, 5.0), 8.0))
	assert((screen.detail_values["PAR031"] as Label).text.contains("("))
	assert((screen.detail_values["PAR033"] as Label).text.contains("%)"))

	assert(screen.detail_values.size() == ParCalculationService.registry().size())
	assert(screen.detail_values.size() == 108)
	assert((screen.detail_values["PAR052"] as Label).text != "—")

	for tab_index in range(4):
		screen.detail_tabs.current_tab = tab_index
		assert(screen.detail_tabs.current_tab == tab_index)
		assert(screen.detail_tabs.get_child(tab_index).name == screen.DETAIL_TAB_NAMES[tab_index])
	screen.size = Vector2(360, 740)
	screen.call("_apply_layout")
	assert(screen.layout_row.vertical)
	assert(screen.square_host.custom_minimum_size == Vector2(360, 360))
	screen.size = Vector2(900, 500)
	screen.call("_apply_layout")
	assert(not screen.layout_row.vertical)
	assert(screen.square_host.custom_minimum_size == Vector2(500, 500))
	assert(screen.square_content.scale == Vector2.ONE * (500.0 / 480.0))
	assert(screen.character.progression.level == 1)
	assert(screen.xp_label.text.contains("900"))
	assert(screen.character.award_xp(900) == 1)
	screen.refresh()
	assert(screen.xp_label.text.contains("Уровень 2"))
	var before := int(screen.character.progression.base_stats["PAR001"])
	screen.call("_allocate", "PAR001")
	assert(int(screen.character.progression.base_stats["PAR001"]) == before)
	assert(screen.character.progression.displayed_stat("PAR001") == before + 1)
	assert(screen.character.progression.unspent_stat_points == 12)
	assert(not screen.save_button.disabled)
	screen.call("_save_pending")
	assert(int(screen.character.progression.base_stats["PAR001"]) == before + 1)
	assert(screen.save_button.disabled)
	screen.back_button.pressed.emit()
	assert(not screen.visible)
	instance.call("_open_panel", "Инвентарь")
	await process_frame
	var inventory := instance.get_node_or_null("InventoryScreen") as InventoryScreen
	assert(inventory != null and inventory.visible)
	assert(inventory.slot_buttons.size() == 14)
	for slot in inventory.slot_buttons:
		var equipment_icon := inventory.slot_buttons[slot] as ItemIcon
		assert(equipment_icon != null)
		assert(equipment_icon.custom_minimum_size == Vector2(ItemIcon.CELL_SIZE, ItemIcon.CELL_SIZE))
	assert(inventory.bag_grid.get_child_count() == 0)
	assert(inventory.slot_buttons.has("hands"))
	assert(inventory.layout_row.get_node("EquipmentPanel/SquareContent/ElixirSlots").get_child_count() == 4)
	assert(inventory.character_portrait.custom_minimum_size == Vector2(356, 416))
	assert(inventory.hp_bar != null)
	assert(inventory.stat_rows.size() == 11)
	assert(inventory.avatar_id == "hero_realistic_01")
	assert(inventory.avatar_texture != null)
	assert(inventory.avatar_texture.texture != null)
	assert(inventory.stats_content.get_node("StatsScroll/CombatTable").get_child_count() == 4)
	assert(inventory.stat_rows.has("Броня по зонам"))
	assert((inventory.stat_rows["Мана"] as Label).text != "—")
	assert((inventory.stat_rows["Попадание"] as Label).text == "—")
	assert((inventory.stat_rows["Общее сопротивление"] as Label).text == "—")
	assert(inventory.hp_bar.max_value > 0)
	assert(inventory.character_portrait != null)
	assert(inventory.character_portrait.get_parent().name == "EquipmentMiddle")
	assert(inventory.bag_title.text == "Сумка (0)")
	assert(inventory.bag_scroll != null)
	inventory.size = Vector2(360, 740)
	inventory.call("_apply_layout")
	assert(inventory.layout_row.vertical)
	assert(inventory.layout_row.get_node("EquipmentPanel").custom_minimum_size == Vector2(360, 360))
	assert(inventory.bag_grid.columns == 7)
	inventory.size = Vector2(900, 500)
	inventory.call("_apply_layout")
	assert(not inventory.layout_row.vertical)
	assert(inventory.layout_row.get_node("EquipmentPanel").custom_minimum_size == Vector2(500, 500))
	assert(inventory.equipment_content.scale == Vector2.ONE * (500.0 / 480.0))
	assert(inventory.bag_grid.columns == 5)
	assert(inventory.slot_buttons.size() == 14)
	assert(inventory.detail_dialog.actions != null)
	assert(inventory.detail_dialog.scroll != null)
	assert(inventory.detail_dialog.backdrop == null)
	assert(inventory.discard_button != null)
	assert(not inventory.discard_mode)
	var sample := {"instance_id": "icon_smoke", "name": "Клинок", "rarity": "blue", "equip_slots": ["main_hand"]}
	ItemDurabilityService.initialize_item(sample, 100)
	assert(inventory.repository.add_item(sample))
	assert(inventory.character.inventory.add_instance("icon_smoke", inventory.repository))
	inventory.refresh()
	assert(inventory.bag_grid.get_child_count() == 1)
	var bag_icon := inventory.bag_grid.get_child(0) as ItemIcon
	assert(bag_icon != null)
	assert(is_equal_approx(bag_icon.custom_minimum_size.x, ItemIcon.CELL_SIZE * (500.0 / 480.0)))
	assert(inventory.bag_grid.get_theme_constant("h_separation") >= 8)
	assert(inventory.bag_panel != null)
	assert(bag_icon.instance_id == "icon_smoke")
	inventory.discard_button.pressed.emit()
	assert(inventory.discard_mode)
	inventory.call("_select_item", "icon_smoke")
	assert(inventory.discard_ids.has("icon_smoke"))
	inventory.discard_cancel.pressed.emit()
	assert(not inventory.discard_mode)
	assert(inventory.discard_ids.is_empty())
	assert(inventory.character.inventory.owns("icon_smoke"))
	inventory.back_button.pressed.emit()
	assert(not inventory.visible)
	print("Character and inventory screen UI smoke: PASS")
	quit(0)

extends SceneTree
func _initialize()->void:
	var map:=TacticalMapState.new(8,8)
	var service:=HexEncounterService.new()
	var valid:=true
	var lever:=HexEncounter.new("ENC_LEVER",HexEncounter.TRIGGER_INTERACT,"apply_effect",{"effect_id":"LEVER_PULL","set_flags":["GATE_OPEN"]},true)
	var gate:=HexEncounter.new("ENC_GATE",HexEncounter.TRIGGER_INTERACT,"reveal_object",{"object_id":"EXIT_PORTAL","position":Vector2i(6,6)},true,["GATE_OPEN"])
	var repeatable:=HexEncounter.new("ENC_FIRE",HexEncounter.TRIGGER_ENTER,"damage",{"amount":5,"set_flags":["FIRE_SEEN"]},false)
	valid=valid and service.add_encounter(lever,Vector2i(2,2),map)
	valid=valid and service.add_encounter(gate,Vector2i(3,2),map)
	valid=valid and service.add_encounter(repeatable,Vector2i(4,2),map)
	valid=valid and service.interact(Vector2i(3,2)).is_empty()
	var lever_events:=service.interact(Vector2i(2,2))
	var lever_result:=HexEncounterChain.resolve_events(lever_events,map,service)
	valid=valid and bool(lever_result.get("ok",false)) and bool(service.world_flags.get("GATE_OPEN",false))
	var gate_events:=service.interact(Vector2i(3,2))
	var gate_result:=HexEncounterChain.resolve_events(gate_events,map,service)
	valid=valid and bool(gate_result.get("ok",false)) and map.cell(Vector2i(6,6)).object_ids.has("EXIT_PORTAL")
	var fire_first:=HexEncounterChain.resolve_events(service.trigger_at(Vector2i(4,2),HexEncounter.TRIGGER_ENTER),map,service)
	var fire_second:=HexEncounterChain.resolve_events(service.trigger_at(Vector2i(4,2),HexEncounter.TRIGGER_ENTER),map,service)
	valid=valid and bool(fire_first.get("ok",false)) and bool(fire_second.get("ok",false)) and bool(service.world_flags.get("FIRE_SEEN",false))
	valid=valid and service.interact(Vector2i(2,2)).is_empty() and service.interact(Vector2i(3,2)).is_empty()
	print("HEX_ENCOUNTER_CHAIN_TEST="+("PASS" if valid else "FAIL"))
	quit(0 if valid else 1)

extends SceneTree

func _initialize() -> void:
	var progression := CharacterProgression.new()
	assert(progression.required_xp() == 900)
	assert(progression.npc_xp(10, 10) == 200)
	assert(progression.npc_xp(10, 9) == 148)
	assert(progression.npc_xp(10, 5) == 0)
	assert(progression.npc_xp(17, 20) == 540)
	assert(progression.npc_xp(17, 20, true) == 810)
	assert(progression.gain_xp(901) == 1)
	assert(progression.level == 2 and progression.xp_into_level == 1)
	assert(progression.unspent_stat_points == 13)
	assert(progression.allocate_stat("PAR001"))
	assert(progression.base_stats["PAR001"] == 1)
	assert(progression.displayed_stat("PAR001") == 2)
	assert(progression.unspent_stat_points == 12)
	assert(progression.remove_pending_stat("PAR001"))
	assert(progression.unspent_stat_points == 13)
	assert(progression.allocate_stat("PAR001"))
	assert(progression.save_pending_stats())
	assert(progression.base_stats["PAR001"] == 2)
	assert(progression.unspent_stat_points == 12)
	assert(not progression.remove_pending_stat("PAR001"))
	assert(CharacterProgression.total_earned_stat_points(20) == 31)
	assert(CharacterProgression.total_earned_stat_points(99) == 110)
	assert(CharacterProgression.total_earned_stat_points(100) == 116)
	var restored := CharacterProgression.new()
	assert(restored.restore(progression.to_dict()))
	assert(restored.to_dict() == progression.to_dict())
	print("Character progression smoke: PASS")
	quit()
